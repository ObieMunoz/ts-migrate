{
    "transform": {
        "^.+\\.ts$": ["ts-jest", { "tsconfig": { "rootDir": "." } }]
    },
    "moduleFileExtensions": [
        "ts",
        "js",
        "json"
    ],
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(ts|js)$",
    "testPathIgnorePatterns": [
        "<rootDir>/node_modules/",
        "<rootDir>/tests/tmp/"
    ]
}